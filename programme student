def create_contacts_file():
    if not os.path.exists(CONTACTS_FILE):
        with open(CONTACTS_FILE, "w", newline="", encoding="utf-8") as file:
            writer = csv.writer(file)
            writer.writerow(["name", "phone", "email"])
            writer.writerows(SAMPLE_DATA)

        print("Sample contacts.csv file created successfully.")


# ==========================================
# VALIDATION FUNCTION
# ==========================================

def validate_contact(name, phone, email):

    name = name.strip()
    phone = phone.strip()
    email = email.strip()

    if not name:
        return False, "Missing Name"

    if not phone:
        return False, "Missing Phone"

    if len(phone) != 10 or not phone.isdigit():
        return False, "Invalid Phone: Must contain exactly 10 digits"

    if phone[0] not in "6789":
        return False, "Invalid Phone: Must start with 6, 7, 8 or 9"

    if not email:
        return False, "Missing Email"

    if email.count("@") != 1:
        return False, "Bad Email: Invalid @ symbol"

    if any(char.isspace() for char in email):
        return False, "Bad Email: Contains whitespace"

    local, domain = email.split("@")

    if not local:
        return False, "Bad Email: Missing username"

    if "." not in domain:
        return False, "Bad Email: Missing domain period"

    if domain.startswith(".") or domain.endswith("."):
        return False, "Bad Email: Invalid domain"

    return True, "Valid"


# ==========================================
# SAVE CLEAN STUDENT DATA
# ==========================================

def save_students():

    with open(CLEAN_FILE, "w", newline="", encoding="utf-8") as file:

        fieldnames = ["id", "name", "phone", "email"]

        writer = csv.DictWriter(file, fieldnames=fieldnames)

        writer.writeheader()

        for student in students:
            writer.writerow(student)

    print("Student records saved successfully.")


# ==========================================
# LOAD STUDENT DATA
# ==========================================

def load_students():

    global students

    students = []

    total = 0
    accepted = 0
    rejected = []

    seen_phones = set()
    seen_emails = set()

    # If clean file already exists, preserve saved changes.
    if os.path.exists(CLEAN_FILE):

        with open(CLEAN_FILE, "r", newline="", encoding="utf-8") as file:

            reader = csv.DictReader(file)

            for row in reader:

                valid, reason = validate_contact(
                    row["name"], row["phone"], row["email"]
                )

                if valid:
                    phone = row["phone"].strip()
                    email = row["email"].strip().lower()

                    if phone in seen_phones or email in seen_emails:
                        continue

                    student = {
                        "id": len(students) + 1,
                        "name": row["name"].strip(),
                        "phone": phone,
                        "email": email
                    }

                    students.append(student)
                    seen_phones.add(phone)
                    seen_emails.add(email)

        print("\nExisting student records loaded successfully.")
        return

    # First-time CSV ingestion
    with open(CONTACTS_FILE, "r", newline="", encoding="utf-8") as file:

        reader = csv.DictReader(file)

        for row in reader:

            total += 1

            name = row.get("name", "")
            phone = row.get("phone", "")
            email = row.get("email", "")

            valid, reason = validate_contact(name, phone, email)

            if not valid:
                rejected.append(reason)
                continue

            phone = phone.strip()
            email = email.strip().lower()

            if phone in seen_phones:
                rejected.append("Duplicate Phone: " + phone)
                continue

            if email in seen_emails:
                rejected.append("Duplicate Email: " + email)
                continue

            student = {
                "id": len(students) + 1,
                "name": name.strip(),
                "phone": phone,
                "email": email
            }

            students.append(student)

            seen_phones.add(phone)
            seen_emails.add(email)

            accepted += 1

    print("\n========== INGESTION REPORT ==========")
    print("Total rows processed :", total)
    print("Valid rows accepted  :", accepted)
    print("Rejected rows        :", total - accepted)

    print("\nRejection Details:")

    for reason in rejected:
        print("-", reason)

    save_students()


