def search_student():

    keyword = input("\nEnter Name, Phone or Email to search: ").strip().lower()

    found = False

    for student in students:

        if (keyword in student["name"].lower()
                or keyword in student["phone"]
                or keyword in student["email"].lower()):

            print("\nStudent Found!")
            print("ID    :", student["id"])
            print("Name  :", student["name"])
            print("Phone :", student["phone"])
            print("Email :", student["email"])

            found = True

    if not found:
        print("Student record not found.")


# ==========================================
# REGISTER NEW STUDENT
# ==========================================

def register_student():

    print("\n========== REGISTER NEW STUDENT ==========")

    name = input("Enter Student Name: ").strip()
    phone = input("Enter Phone Number: ").strip()
    email = input("Enter Email Address: ").strip()

    valid, reason = validate_contact(name, phone, email)

    if not valid:
        print("Registration Failed:", reason)
        return

    for student in students:

        if student["phone"] == phone:
            print("Registration Failed: Duplicate phone number.")
            return

        if student["email"].lower() == email.lower():
            print("Registration Failed: Duplicate email.")
            return

    new_student = {
        "id": max([s["id"] for s in students], default=0) + 1,
        "name": name,
        "phone": phone,
        "email": email
    }

    students.append(new_student)

    save_students()

    print("\nStudent registered successfully!")


# ==========================================
# UPDATE STUDENT
# ==========================================

def update_student():

    print("\n========== UPDATE STUDENT ==========")

    try:
        student_id = int(input("Enter Student ID to update: "))
    except ValueError:
        print("Please enter a valid numeric ID.")
        return

    for student in students:

        if student["id"] == student_id:

            print("\nCurrent Details:")
            print("Name :", student["name"])
            print("Phone:", student["phone"])
            print("Email:", student["email"])

            name = input("Enter New Name (press Enter to keep): ").strip()
            phone = input("Enter New Phone (press Enter to keep): ").strip()
            email = input("Enter New Email (press Enter to keep): ").strip()

            name = name if name else student["name"]
            phone = phone if phone else student["phone"]
            email = email if email else student["email"]

            valid, reason = validate_contact(name, phone, email)

            if not valid:
                print("Update Failed:", reason)
                return

            for other in students:

                if other["id"] != student_id:

                    if other["phone"] == phone:
                        print("Duplicate phone number!")
                        return

                    if other["email"].lower() == email.lower():
                        print("Duplicate email address!")
                        return

            student["name"] = name
            student["phone"] = phone
            student["email"] = email

            save_students()

            print("Student details updated successfully!")
            return

    print("Student ID not found.")


# ==========================================
# DELETE STUDENT
# ==========================================

def delete_student():

    print("\n========== DELETE STUDENT ==========")

    choice = input("Delete using (1) ID or (2) Phone: ")

    if choice == "1":

        try:
            student_id = int(input("Enter Student ID: "))
        except ValueError:
            print("Invalid ID.")
            return

        for student in students:

            if student["id"] == student_id:

                confirm = input("Confirm deletion? (yes/no): ").lower()

                if confirm == "yes":
                    students.remove(student)
                    save_students()
                    print("Student deleted successfully!")
                else:
                    print("Deletion cancelled.")

                return

    elif choice == "2":

        phone = input("Enter Phone Number: ").strip()

        for student in students:

            if student["phone"] == phone:

                confirm = input("Confirm deletion? (yes/no): ").lower()

                if confirm == "yes":
                    students.remove(student)
                    save_students()
                    print("Student deleted successfully!")
                else:
                    print("Deletion cancelled.")

                return

    else:
        print("Invalid choice.")
        return

    print("Student record not found.")


# ==========================================
# BUSINESS INTELLIGENCE ANALYTICS
# ==========================================

def analytics_report():

    print("\n")
    print("=" * 55)
    print("     STUDENT REGISTRATION - BUSINESS INTELLIGENCE")
    print("=" * 55)

    # Read raw data to calculate quality statistics
    total = 0
    rejection_counts = {}
    seen_phones = set()
    seen_emails = set()
    raw_accepted = 0

    with open(CONTACTS_FILE, "r", newline="", encoding="utf-8") as file:

        reader = csv.DictReader(file)

        for row in reader:

            total += 1

            name = row.get("name", "")
            phone = row.get("phone", "")
            email = row.get("email", "")

            valid, reason = validate_contact(name, phone, email)

            if not valid:
                rejection_counts[reason] = rejection_counts.get(reason, 0) + 1
                continue

            phone = phone.strip()
            email = email.strip().lower()

            if phone in seen_phones:
                rejection_counts["Duplicate Phone"] = rejection_counts.get(
                    "Duplicate Phone", 0
                ) + 1
                continue

            if email in seen_emails:
                rejection_counts["Duplicate Email"] = rejection_counts.get(
                    "Duplicate Email", 0
                ) + 1
                continue

            seen_phones.add(phone)
            seen_emails.add(email)
            raw_accepted += 1

    accuracy = (raw_accepted / total * 100) if total else 0

    print("\n--- DATA QUALITY DIAGNOSTIC ---")
    print("Total Contacts Processed :", total)
    print("Valid Registrations      :", raw_accepted)
    print("Rejected Records         :", total - raw_accepted)
    print("Data Quality Accuracy    : {:.2f}%".format(accuracy))

    print("\n--- REJECTION REASONS ---")

    if rejection_counts:
        for reason, count in rejection_counts.items():
            print(reason, ":", count)
    else:
        print("No rejected records.")

    # Telecom distribution
    telecom = {"9": 0, "8": 0, "7": 0, "6": 0}

    # Email domain distribution
    domains = {}

    for student in students:

        first_digit = student["phone"][0]

        if first_digit in telecom:
            telecom[first_digit] += 1

        domain = student["email"].split("@")[1]

        domains[domain] = domains.get(domain, 0) +1
    print("\n--- TELECOM NETWORK DISTRIBUTION ---")

    for digit in ["9", "8", "7", "6"]:
        print(digit + "-Series:", telecom[digit], "students")

    print("\n--- EMAIL DOMAIN BREAKDOWN ---")

    sorted_domains = sorted(
        domains.items(),
        key=lambda item: item[1],
        reverse=True
    )

    for domain, count in sorted_domains:
        print("@{:<20}: {} students".format(domain, count))

    print("\n--- CURRENT DATABASE SUMMARY ---")
    print("Currently Registered Students:", len(students))

    print("=" * 55)


